{
  "name": "mcmasterful-warehouse",
  "version": "1.2.2",
  "private": true,
  "description": "The McMasterful Books warehouse API: shelf stock and order fulfilment.",
  "main": "index.ts",
  "scripts": {
    "start-server": "../generate-openapi.sh && tsx ./index.ts",
    "lint": "../generate-openapi.sh && eslint --ext .ts .",
    "fix-lint": "../generate-openapi.sh && eslint --ext .ts --fix .",
    "check-types": "../generate-openapi.sh && tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@koa/cors": "5.0.0",
    "@koa/router": "12.0.1",
    "koa": "2.15.2",
    "koa-bodyparser": "4.4.1",
    "mongodb": "6.5.0",
    "tsoa": "6.2.0"
  },
  "devDependencies": {
    "@types/koa": "2.15.0",
    "@types/koa__cors": "5.0.0",
    "@types/koa__router": "12.0.4",
    "@types/koa-bodyparser": "4.3.12",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.1.1",
    "mongodb-memory-server": "9.1.8",
    "typescript": "5.4.3",
    "vitest": "1.4.0"
  },
  "overrides": {
    "@tsoa/cli": "6.2.0",
    "@tsoa/runtime": "6.2.0",
    "typescript": "5.4.3"
  }
}
